{
  "version": 2,
  "rewrites": [
    { "source": "/redirect", "destination": "/api/redirect" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self';" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/old-path", "destination": "/redirect", "permanent": false }
  ],
  "functions": {
    "api/redirect.js": { "maxDuration": 10 }
  }
}